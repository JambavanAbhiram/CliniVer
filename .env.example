# Copy to `.env` and fill in. `.env` is git-ignored: never commit real values.

# --- NCBI E-utilities (PubMed, PMC, PubTator) ---
# A free API key raises the rate limit from 3 to 10 requests/second.
# Create one at: https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=
# NCBI asks API clients to identify themselves with a contact email.
NCBI_EMAIL=

# --- openFDA (optional; a free key raises the daily request quota) ---
OPENFDA_API_KEY=

# --- Runtime overrides (optional) ---
# Leave commented out to use configs/project.yaml. Uncomment ONLY to deliberately
# override it on this machine; an override silently replaces the YAML value.
# CLINIVER_LOG_LEVEL=DEBUG        # DEBUG | INFO | WARNING | ERROR
# CLINIVER_DEVICE=cpu             # auto | cuda | cpu
